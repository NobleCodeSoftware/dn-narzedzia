# Cloudflare Pages: nagłówki dla wszystkich ścieżek. Wersja po włączeniu indeksowania (bez noindex na stronach).
# CSP musi być zgodny z meta CSP w plikach HTML (sprawdza test/strony.test.js).
# connect-src: 'self' (wzór arkusza do eksportu XLSX z /pobierz/) i https://api.nbp.pl (kurs średni NBP
# w ewidencji; API odpowiada nagłówkiem Access-Control-Allow-Origin: *). Nic więcej.
# Cloudflare Web Analytics NIE jest włączone; żeby je włączyć, dopisz
# https://static.cloudflareinsights.com do script-src i https://cloudflareinsights.com do connect-src.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self' https://api.nbp.pl; base-uri 'none'; form-action 'none'; upgrade-insecure-requests; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
# Arkusz do pobrania: zawsze jako plik, nie podgląd w przeglądarce.
/pobierz/*
  Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
  Content-Disposition: attachment; filename="arkusz-limit-dn.xlsx"
  X-Robots-Tag: noindex
# Adresy *.pages.dev (projekt i podglądy wersji) nie trafiają do wyników: indeksujemy tylko dn.noblecode.pl.
# Reguła /* nie może mieć tego nagłówka, bo Cloudflare łączy nagłówki z kilku pasujących reguł.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
