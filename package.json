{
  "name": "dn-narzedzia",
  "version": "0.4.3",
  "private": true,
  "description": "Narzędziownik DN: licznik limitu, ewidencja sprzedaży w przeglądarce (prognoza, kurs NBP, wydruk), faktura bez VAT (zwolnienie) w PDF i darmowy arkusz XLSX.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test",
    "serve": "python3 -m http.server 8080 --directory public",
    "check:publish": "node scripts/sprawdz-publikacje.mjs",
    "arkusz": "python3 scripts/arkusz.py --sprawdz",
    "test:a11y": "node scripts/sprawdz-dostepnosc.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "playwright-core": "1.56.1"
  }
}
